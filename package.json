{
  "name": "replyraven",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted Google Business Profile review workspace powered by Sheets and GitHub Actions.",
  "scripts": {
    "dev": "node scripts/serve.js",
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "sync": "node scripts/sync-reviews.js",
    "reply": "node scripts/auto-reply.js",
    "get-token": "node scripts/get-token.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "google-spreadsheet": "^5.3.0",
    "googleapis": "^170.1.0",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^143.0.4",
    "lucide": "^0.468.0",
    "prettier": "^3.9.9"
  }
}
