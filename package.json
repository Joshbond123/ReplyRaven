{
  "name": "replyraven",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ReplyRaven — brand-aware Google review automation on Cloudflare.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.js",
    "dev:api": "node scripts/local-api.js",
    "build": "node scripts/build.js",
    "verify": "node checks/run.js",
    "verify:browser": "node scripts/verify-browser.js",
    "verify:live": "node scripts/verify-live.js",
    "deploy:backend": "node scripts/deploy-cloudflare.js",
    "publish:branch": "node scripts/publish-branch.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:bundle": "wrangler deploy --dry-run --outdir .cache/worker-bundle"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^143.0.4",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.0.0"
  }
}
